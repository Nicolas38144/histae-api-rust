import common.caddy

https://:443 {
	import storage_https
	@unsupported not method GET HEAD
	handle @unsupported {
		header Allow "GET, HEAD"
		respond 405
	}
	@presigned_object {
		method GET HEAD
		path_regexp ^/[^/]+/[^/].*
		query X-Amz-Algorithm=AWS4-HMAC-SHA256 X-Amz-Signature=*
		not header Authorization *
	}
	handle @presigned_object {
		import seaweed_s3
	}
	handle {
		respond 403
	}
}
